# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/postfusion_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/oauth/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0

# Instagram Business / Creator account linked to the Facebook Page above
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Threads (Meta) — long-lived user token with threads_basic + threads_content_publish
# TOKEN alone is enough; user id is resolved from GET /me. Do NOT put a Facebook Page ID here.
THREADS_ACCESS_TOKEN=
# Optional override (usually leave blank):
THREADS_USER_ID=
THREADS_API_VERSION=v1.0
# Public HTTPS URL Meta can reach for Instagram/Threads image posts (e.g. ngrok).
PUBLIC_BASE_URL=
